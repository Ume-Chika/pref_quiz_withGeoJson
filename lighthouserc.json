{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": ["http://localhost/index.html"],
      "numberOfRuns": 1,
      "settings": {
        "onlyCategories": ["performance"],
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
